# ==============================================================================
# NETRA ECOSYSTEM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env` for local development. DO NOT commit actual secrets to Git.
# Supported Environments: development | test | staging | production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETRA BACKEND CONFIGURATION (netra-backend)
# ------------------------------------------------------------------------------
NETRA_ENV=development
NETRA_HOST=127.0.0.1
NETRA_PORT=4000
NETRA_LOG_LEVEL=INFO
NETRA_API_PREFIX=/api/v1
NETRA_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL Connection URL (PostgreSQL 16 with RLS)
NETRA_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/netra_db
NETRA_DATABASE_POOL_MIN=2
NETRA_DATABASE_POOL_MAX=10

# Security & Authentication Secrets (Cryptographically random 256-bit keys)
NETRA_JWT_SECRET=
NETRA_JWT_REFRESH_SECRET=
NETRA_JWT_ALGORITHM=HS256
NETRA_JWT_ACCESS_EXPIRATION_MINUTES=15
NETRA_JWT_REFRESH_EXPIRATION_DAYS=7
NETRA_JWT_ISSUER=netra-backend
NETRA_JWT_AUDIENCE=netra-client

# ------------------------------------------------------------------------------
# 2. DISCORD CONTROL PLANE CONFIGURATION (netra-discord - Future Phase)
# ------------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
NETRA_CORE_API_URL=http://localhost:4000/api/v1

# ------------------------------------------------------------------------------
# 3. LOCAL NETRA AGENT CONFIGURATION (netra-agent - Future Phase)
# ------------------------------------------------------------------------------
NETRA_AGENT_CORE_URL=http://localhost:4000/api/v1
NETRA_AGENT_WSS_URL=ws://localhost:4000/api/v1/agent/connect
NETRA_AGENT_DEVICE_ID=
NETRA_AGENT_POLL_INTERVAL=15
