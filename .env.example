# ==============================================================================
# NETRA ECOSYSTEM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env` for local development. DO NOT commit actual secrets to Git.
# Supported Environments: development | test | staging | production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REPOSITORY 1: NETRA BACKEND CONFIGURATION (netra-backend)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# PostgreSQL Connection URL (PostgreSQL 16 with RLS)
DATABASE_URL=postgresql://netra_app_user:change_this_password@localhost:5432/netra_db?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Cache & Nonce Tracking
REDIS_URL=redis://localhost:6379

# Security & Authentication Secrets (Cryptographically random 256-bit keys)
JWT_SECRET=change_this_to_a_long_random_jwt_secret_key_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change_this_to_a_long_random_refresh_secret_key
JWT_REFRESH_EXPIRATION=7d

# Signature & Timestamp Skew Window
SIGNATURE_MAX_SKEW_SECONDS=300

# ------------------------------------------------------------------------------
# 2. REPOSITORY 2: DISCORD CONTROL PLANE CONFIGURATION (netra-discord)
# ------------------------------------------------------------------------------
# Shared service secret for Backend ↔ Discord Bot authorization
DISCORD_SERVICE_SECRET=change_this_to_a_secure_discord_service_secret

# Discord Application Credentials (from Discord Developer Portal)
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_development_guild_id_here

# Core Backend Base URL for Discord Bot API requests
NETRA_CORE_API_URL=http://localhost:4000/api/v1

# ------------------------------------------------------------------------------
# 3. REPOSITORY 3: LOCAL NETRA AGENT CONFIGURATION (netra-agent)
# ------------------------------------------------------------------------------
NETRA_AGENT_CORE_URL=http://localhost:4000/api/v1
NETRA_AGENT_WSS_URL=ws://localhost:4000/api/v1/agent/connect
NETRA_AGENT_DEVICE_ID=
NETRA_AGENT_KEYRING_SERVICE=netra_agent_ed25519
NETRA_AGENT_POLL_INTERVAL=15

# ------------------------------------------------------------------------------
# 4. OBSERVABILITY & TELEMETRY CONFIGURATION
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=
METRICS_PORT=9090

